# OS / IDE cruft
.DS_Store
.idea/

# Claude Code session-local runtime state -- not project config
.claude/scheduled_tasks.lock

# Raw source material for the knowledge base (PDFs, book photos) -- large,
# likely-copyrighted binaries, and not needed at runtime: knowledge/*.md is
# the derivative synthesis actually used by Skills/Agents. Keep these local.
docs/Footprint/
docs/TTrades PDFs/
docs/Wyckoff and Modern Tools/
docs/Wyckoff Advance/
# .cache/ holds page scans (JPEG) of the two Wyckoff books above: copyrighted, 274 MB -- same rule as the books.
.cache/

# Runtime market data and pilot state. Tracked since 2026-09-19 by user decision ("push everything that was
# ignored, except sensitive files"): the shared candle cache, feed-health, latency traces, pilot state and
# logs are the evidence behind the day's findings and are cheap (~22 MB). Three exceptions stay out:
#   - data/live/mt5-bridge is a SYMLINK into this machine's home directory (the MT5 Common\Files folder) --
#     meaningless on any other machine, and the folder it points at holds the terminal's own files;
#   - lock/tmp files are process-local;
#   - config/env.* below never move, whatever else does.
data/live/mt5-bridge
data/live/**/*.lock
# forward cycle runtime (scripts/forward_cycle.py): paper log, rolling 5m store, demo executor state/log, cycle log -- per machine
data/live/forward/
data/live/**/*.tmp
data/live/**/*.tmp.*

# Trading environment files hold account credentials (or Keychain references).
# Only the template config/env.example is committed. Keep the real files chmod 600.
config/env.demo
config/env.real
config/env.*.local

# Secrets -- CoinGlass API key, Binance Testnet key/secret, etc. go in one of
# these once provided; never commit them, even to a private repo.
.env
.env.*
config/secrets*.json
config/secrets*.local.*
*.secrets.json

# Re-include docs/ subdirectories this project needs tracked -- a machine-wide
# global gitignore (~/.gitignore_global) has a blanket "docs/*" rule that would
# otherwise silently exclude these from every commit.
!docs/architecture/
!docs/architecture/**
!docs/edge-log/
!docs/edge-log/**
!docs/mistakes/
!docs/mistakes/**
!docs/backtests/
!docs/backtests/**
!docs/audits/
!docs/audits/**
!docs/plans/
!docs/plans/**
!docs/specs/
!docs/specs/**
!docs/prompts/
!docs/prompts/**
!docs/security/
!docs/security/**
# Top-level docs/ FILES need their own rule: the re-includes above are all directories, so a file sitting
# directly in docs/ stayed excluded. docs/GETTING-STARTED.md had therefore never been tracked at all -- it is
# the entry-point document, it was rewritten on 2026-09-13 to describe the collapsed one-engine system, and none
# of that would have survived a fresh clone. Found by the Task 5 implementer; it is concern C4 in
# docs/security/2026-09-11-top5-pilot.md, which had only got as far as docs/security/.
!docs/GETTING-STARTED.md

# scripts/automation.py's atomic locked write (CFG-01, docs/security/2026-09-12-method-panel.md) -- the lock
# file and the tmp file it os.replace()s into place are runtime artifacts, never the config itself.
docs/architecture/automation-config.json.lock
docs/architecture/automation-config.json.tmp

__pycache__/
# data/history/ (stored candle history, ~390 MB, and the stability tables built from it) is TRACKED since
# 2026-09-19 by the same user decision: every backtest number in docs/ points at these files, and a clone
# without them cannot reproduce a single result (CLAUDE.md §10, §46).

# .playwright-mcp/ (browser-verification screenshots and snapshots) and .goal/ (the session goal record) are
# TRACKED since 2026-09-19 by user decision ("push everything that was ignored, except sensitive files").

# Stage H1 Bookmap recorder (docs/security/2026-09-26-bookmap-recorder-h1.md BMREC-18): recordings NEVER live in
# the repo (C:\TradingData\bookmap-recordings, outside every worktree). The only recorder artefact written inside
# the repo is the add-on build output; it is reproducible from source + integrations/bookmap/addon-pin.json.
integrations/bookmap/dist/
!docs/contracts/
!docs/contracts/**
!docs/research/
!docs/research/**
# per-account runtime (scripts/fvg_demo.py, strategy-runner.py --account): state, event log, STOP -- per machine
data/live/accounts/
__pycache__/

# Binance USDT-M perpetual history imported from the PUBLIC archive data.binance.vision by
# scripts/import-binance-um-history.py: every source zip is checksum-verified and its sha256 is recorded in the series'
# index.json, so the data is reproducible from the archive. The bulky year parts and funding files stay local; the
# index.json files (provenance + digests) are tracked.
data/history/binance_um/**/*.json.gz
data/history/binance_um/*.json.gz
data/history/binance_spot/**/*.json.gz
