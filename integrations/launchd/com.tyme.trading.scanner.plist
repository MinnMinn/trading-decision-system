<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.tyme.trading.scanner</string>
  <key>ProgramArguments</key><array><string>/bin/bash</string><string>/Users/tungnguyen/TYME/Trading/scripts/scan-loop.sh</string></array>
  <key>WorkingDirectory</key><string>/Users/tungnguyen/TYME/Trading</string>
  <key>StartInterval</key><integer>60</integer>
  <key>RunAtLoad</key><true/>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string></dict>
  <key>StandardOutPath</key><string>/Users/tungnguyen/TYME/Trading/data/live/scan-loop.out</string>
  <key>StandardErrorPath</key><string>/Users/tungnguyen/TYME/Trading/data/live/scan-loop.err</string>
  <key>ProcessType</key><string>Background</string>
  <!-- scan-loop.sh detaches the model layer with `( nohup bash scripts/model-read.sh … & )` and exits within seconds.
       Without this key launchd SIGTERMs the whole process group when the job exits (launchd.plist(5)), so every
       headless read (layer 2 and the 07:30Z daily full) died ~1 s after spawn (2026-09-20: `Terminated: 15` in
       data/live/model-reads.log, narrative/scalping.json frozen at 09-11). scripts/tests/test_scan_loop.py pins it. -->
  <key>AbandonProcessGroup</key><true/>
</dict></plist>
