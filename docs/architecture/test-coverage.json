  "critical_invariant": {
    "spec_text": "A required analysis failure must never silently become an optional analysis.",
    "covered": true,
    "by": [
      "scripts/tests/test_trading_system.py::test_there_is_no_runtime_reclassification",
      "scripts/tests/test_trading_system.py::test_missing_context_resolves_required_never_optional",
      "scripts/tests/test_trading_system.py::test_a_baseline_role_of_required_refuses_to_load"
    ],
    "_note": "The previous audit recorded this as UNTESTABLE -- 'there is no classification field to assert on'. §35 created the field, so the invariant now has three separate guards: a runtime reclassify that only raises, unknown context resolving REQUIRED rather than optional, and a registry that refuses required-ness being inherited (which is how a dependency would become required-for-everything and then be relaxed for one caller)."
  }
