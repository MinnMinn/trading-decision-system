{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/session-safety-rules.sh\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo \"{\\\"systemMessage\\\":\\\"If a TRADE/WAIT/NO_TRADE verdict was just produced, confirm it is recorded via /journal.\\\"}\""
          }
        ]
      }
    ]
  }
}
