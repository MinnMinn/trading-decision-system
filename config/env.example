# Trading environment file -- TEMPLATE (committed). Copy to config/env.demo or config/env.real and fill in.
# Loaded by scripts/trading-env.sh (bash) and scripts/trading_env.py (python) according to
# docs/architecture/automation-config.json -> execution.environment ("demo" | "real").
#
# RULES
#   * config/env.demo and config/env.real are gitignored and must be chmod 600. Never commit them, never paste
#     their contents into chat, never echo a secret. Loaders export values into the environment only.
#   * A secret value may be either a literal, or "keychain:<service>[@<account>]" which is resolved at load time
#     through scripts/get-secret.sh (macOS Keychain). Keychain is the recommended form for real keys.
#   * "__FILL_ME__" or an empty value for a REQUIRED secret makes every execution path refuse to run
#     (exit 2, "environment incomplete"). This is a correctness check, not a policy block.
#   * Hard rules that survive in every environment: NEVER Forex; instruments limited to
#     BTCUSDT/ETHUSDT/SOLUSDT/XAUUSD/XAGUSD/USOIL/UKOIL; PILOT_RISK_PCT <= docs/architecture/risk-config.json max_risk_pct (1% per trade; user decision 2026-09-17 unifying the manual and pilot ceilings), paired with the 3R planned-R:R floor.

TRADING_ENV_NAME=example

# ---------------------------------------------------------------- Binance (crypto execution + balance)
# demo: https://testnet.binance.vision + https://testnet.binancefuture.com
# real: https://api.binance.com      + https://fapi.binance.com
BINANCE_SPOT_BASE_URL=https://testnet.binance.vision
BINANCE_FUTURES_BASE_URL=https://testnet.binancefuture.com
BINANCE_SPOT_API_KEY=__FILL_ME__
BINANCE_SPOT_SECRET_KEY=__FILL_ME__
BINANCE_FUTURES_API_KEY=__FILL_ME__
BINANCE_FUTURES_SECRET_KEY=__FILL_ME__

# ---------------------------------------------------------------- MT5 (CFD: XAUUSD/XAGUSD/USOIL/UKOIL)
# Today the MT5 side is DATA ONLY (integrations/mt5/ExportOHLCV.mq5 writes candles into MT5_BRIDGE_DIR).
# The fields below are carried so a future MT5 execution connector reads the same file; nothing uses the
# password yet. Keep MT5 open before `/automation on` so the bridge files stay fresh.
MT5_ACCOUNT_LOGIN=
MT5_SERVER=
MT5_PASSWORD=
MT5_BRIDGE_DIR=data/live/mt5-bridge
MT5_BRIDGE_MAX_AGE_MIN=30

# ---------------------------------------------------------------- Pilot (rules-only automated execution)
# Which pilot loops `/automation on` starts: spot | futures | spot,futures
PILOT_MARKETS=futures
# Fraction of USDT equity risked per trade. The ceiling is NOT written here: it is
# docs/architecture/risk-config.json max_risk_pct, read through scripts/trading_env.py MAX_RISK_PCT (1% since
# the 2026-09-17 unification). trading_env.py clamps the file value and strategy-runner.py clamps again --
# two layers, one number. A value above the ceiling is not an error, it is silently clamped down, so setting
# 0.03 here would simply trade at 1%.
# History, because this line has been wrong twice: it once warned that a second engine re-clamped to 1% of its
# own (that engine was deleted 2026-09-13), and it read "Hard ceiling 0.01 (1%)" while setting 0.03, caught by
# the 2026-09-13 security review (F3). Both were the same failure -- a comment carrying its own copy of a
# number. It no longer carries one.
PILOT_RISK_PCT=0.01
# Max simultaneous open positions across the pilot, and max entries per symbol per UTC day.
PILOT_MAX_OPEN=2
PILOT_MAX_TRADES_PER_DAY=3
